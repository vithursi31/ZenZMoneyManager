# Copy this file to .env.local (gitignored) and fill in real values:
#   cp docs/api/.env.local.example docs/api/.env.local
# Every script in docs/api/ reads it.

# Base URL of the running backend.
HOST=http://localhost:8080

# Credentials the scripts auto-authenticate with (define-envars.sh logs in with
# these to obtain a JWT for the protected endpoints). Must be an existing,
# email-verified user (register + verify first if needed).
API_EMAIL=you@example.com
API_PASSWORD=ChangeMe123!

# Optional: pin tokens to skip the auto-login on each run. Leave blank to have
# define-envars.sh fetch a fresh access + refresh token from /authenticate.
# ACCESS_TOKEN=
# REFRESH_TOKEN=
