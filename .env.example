# Copy this file to .env on the server and fill in real values.
#   cp .env.example .env && nano .env
# .env is gitignored — never commit real secrets.

# ---- Spring profile ----
# "prd" or "dev" (both read config from these env vars).
SPRING_PROFILES_ACTIVE=prd

# ---- Database (Postgres in Docker) ----
POSTGRES_USER=zenzmoney
POSTGRES_DB=zenzmoney
# CHANGE THIS to a strong password.
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Auth ----
# MUST be a long random string, >= 64 bytes for the HS512 JWT signing.
# Generate one:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-with-openssl-rand-base64-64

# Public base URL of the app — used in verification / password-reset links.
# e.g. http://<your-vm-public-ip>:8080  or  https://your-domain.com
APP_BASE_URL=http://localhost:8080

# ---- SMTP (optional) ----
# Leave blank to skip real email; the app logs verification/reset links to the
# console as a dev fallback.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@zenzmoney.local

# ---- OAuth (optional — fill only the providers you use) ----
GOOGLE_APP_ID=
GOOGLE_APP_SECRET=
GOOGLE_REDIRECT_URL=
GOOGLE_IOS_APP_ID=
GOOGLE_ANDROID_APP_ID=

APPLE_CLIENT_ID=
APPLE_CLIENT_ID_WEB=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=
FACEBOOK_GRAPH_VERSION=v19.0

# ---- Self-hosted LLM (chat transaction entry, F-1.9a) ----
# Only needed if you run the optional "ollama" service:
#   docker compose -f docker-compose.prod.yml --profile llm up -d
#   docker compose -f docker-compose.prod.yml exec ollama ollama pull $LLM_MODEL
# Without it the app still runs — chat entry just answers "I couldn't read that".
# 1.5B fits a small CPU-only VM; use qwen2.5:7b-instruct with >= 16 GB RAM.
# Both are Apache 2.0 — avoid qwen2.5:3b, which is non-commercial (qwen-research).
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_TIMEOUT_MS=20000
